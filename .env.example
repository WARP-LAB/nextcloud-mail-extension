# The Nextcloud test server for integration tests. Copy this file to .env, which is git-ignored, and fill it in.
# Use only a test server and a test account (AGENTS.md). An app password is better than the account password:
# Nextcloud, Settings, Security, Devices & sessions.
NCAM_TEST_SERVER_URL=https://cloud.example.com
NCAM_TEST_USERNAME=testuser
NCAM_TEST_PASSWORD=app-password
# The upload directory on the server. Each test email gets its own subfolder in it.
NCAM_TEST_DIRECTORY=NextcloudAppleMailDir001
