# The Nextcloud test server for integration tests. Copy this file to .env, which is git-ignored, and fill it in.
# Use only a test server and a test account (AGENTS.md). The password is the account's own: each run of the tests or
# the tool turns it into an app password and revokes that at the end, which Nextcloud refuses to do from an app password.
NCME_TEST_SERVER_URL=https://cloud.example.com
NCME_TEST_USERNAME=testuser
NCME_TEST_PASSWORD=account-password
# The upload directory on the server. Each test email gets its own subfolder in it.
NCME_TEST_DIRECTORY=NextcloudMailExtensionDir001
# Two of your own accounts in Apple Mail, which the Mail checks send between: each one's name in Mail's account list
# and its address. They stay in this file only, never in code or docs.
NCME_MAIL_A_ACCOUNT="Account A"
NCME_MAIL_A_ADDRESS=a@example.com
NCME_MAIL_B_ACCOUNT="Account B"
NCME_MAIL_B_ADDRESS=b@example.com
# The name of one of Mail's signatures that has an image, for the signature check.
NCME_MAIL_SIGNATURE="Signature with an image"
