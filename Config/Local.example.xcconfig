// The keys Config/Local.xcconfig sets, which Signing.xcconfig includes. Copy this file to Config/Local.xcconfig,
// which git ignores, and fill in DEVELOPMENT_TEAM. Never put the team ID in this file.

// Let Xcode manage signing and provisioning profiles.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// Your 10-character Apple team ID. A free Personal Team is enough for local builds (D11). It's shown in Xcode,
// Settings > Accounts, and in the certificate's Organizational Unit.
DEVELOPMENT_TEAM =
